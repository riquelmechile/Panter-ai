# Plantilla de %h/panter-ai/etc/panter.env (el EnvironmentFile de la unidad), permisos 0600. Nunca versionar el archivo real.
# IMPORTANTE: una variable presente pero VACIA (VAR=) no equivale a "sin definir".
# systemd la pasa como cadena vacia y el servidor no aplica su valor por defecto:
# por ejemplo PANTER_BIND_HOST= escucha en TODAS las interfaces. Las variables opcionales
# que no se usen deben quedar COMENTADAS, nunca vacias.

# --- Valores no secretos (canary privado en loopback) ---
PANTER_AUTH_MODE=embedded
PANTER_BIND_HOST=127.0.0.1
PANTER_PORT=18080
PANTER_ALLOWED_HOSTS=127.0.0.1,localhost
# URL publica ficticia y no enrutable hasta que exista dominio + TLS.
PANTER_PUBLIC_MCP_URL=https://panter.invalid/mcp
PANTER_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Rutas ABSOLUTAS fuera del arbol del release (nunca vacias).
PANTER_DATA_DIR=/ruta/absoluta/panter-ai/data
PANTER_ADMIN_SOCKET=/ruta/absoluta/panter-ai/data/operator.sock
PANTER_ENGRAM_ENABLED=0
PANTER_GITHUB_ALLOWED_REPOS=riquelmechile/Panter-ai
PANTER_GITHUB_REQUIRED_CHECKS=test,arm64-image
PANTER_GITHUB_INDEPENDENT_REVIEWER=sebastianriquelme95-max

# --- Secretos: generarlos en el host (>=48 caracteres, distintos entre si), sin imprimirlos ---
# PANTER_CONSENT_PASSWORD=
# PANTER_OPERATOR_TOKEN=

# --- Opcionales: dejar comentados salvo que se necesiten ---
# Solo detras de un proxy verificado:
# PANTER_TRUSTED_PROXY_CIDRS=
# Solo si un cliente de navegador envia Origin:
# PANTER_ALLOWED_ORIGINS=
