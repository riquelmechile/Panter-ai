{
  "name": "panter-ai",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Independent open-source MCP control plane for host-powered development.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:oauth": "node scripts/smoke-oauth.mjs",
    "smoke:embedded": "node scripts/smoke-embedded.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "zod": "^4.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "esbuild": "^0.25.0"
  },
  "license": "MIT"
}
