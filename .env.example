# Generate a unique high-entropy token; never commit its real value.
PANTER_TOKEN=replace-with-a-random-secret
PANTER_PORT=8080
PANTER_BIND_HOST=127.0.0.1
PANTER_DATA_DIR=.panter-data
# Only necessary when browsers send Origin headers.
PANTER_ALLOWED_ORIGINS=
# Required for binding beyond loopback, e.g. api.example.org
PANTER_ALLOWED_HOSTS=

# ALPHA ONLY: separate opaque tokens for authenticated host tools; NOT OAuth
# PANTER_PEER_TOKENS={"gpt-a":"unique-strong-secret-of-24-or-more","gpt-b":"another-unique-strong-secret","grok":"...","gemini":"...","claude":"..."}

# OPTIONAL: external OAuth 2.1 identity provider; NOT a built-in OAuth login.
# When enabled, only externally signed, client-bound JWTs can use /mcp.
# PANTER_AUTH_MODE=external-jwt
# PANTER_PUBLIC_MCP_URL=https://panter.example.org/mcp
# PANTER_OAUTH_ISSUER=https://id.example.org
# PANTER_OAUTH_JWKS_FILE=/run/panter-identity/jwks.json
# PANTER_OAUTH_ACTORS_FILE=/run/panter-identity/actors.json
# See docs/OAUTH_EXTERNAL.md; never commit real actor subjects, private keys or tokens.
